# ── Firebase ──────────────────────────────────────────────────────────────
# El JSON completo de la cuenta de servicio, en una sola linea.
# Consola de Firebase → Configuracion del proyecto → Cuentas de servicio →
# Generar nueva clave privada.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ecommerce-yenny", ...}

# Alternativa en local: ruta al mismo JSON
# GOOGLE_APPLICATION_CREDENTIALS=./clave-firebase.json

# Con los emuladores no hacen falta credenciales:
# FIREBASE_PROJECT_ID=demo-yeny
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── App ───────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

# Dominios que pueden llamar al backend. Las peticiones REST llegan por el
# mismo dominio (Hosting redirige /api), pero el WebSocket va directo a Cloud
# Run y ahi el navegador si exige CORS.
CORS_ORIGINS=https://ecommerce-yenny.web.app,https://ecommerce-yenny-admin.web.app

# Dominio publico de la tienda: se usa en el sitemap.
APP_URL=https://ecommerce-yenny.web.app

# ── Pagos ─────────────────────────────────────────────────────────────────
MOCK_PAYMENT_MODE=false
BANCO_GENERAL_MERCHANT_ID=
BANCO_GENERAL_API_KEY=
BANCO_GENERAL_SECRET_KEY=
BANCO_GENERAL_ENDPOINT=https://api.bancoGeneral.com/v1
