# Banco General Configuration
BANCO_GENERAL_MERCHANT_ID=tu_merchant_id_aqui
BANCO_GENERAL_API_KEY=tu_api_key_aqui
BANCO_GENERAL_SECRET_KEY=tu_secret_key_aqui
BANCO_GENERAL_ENDPOINT=https://api.bancoGeneral.com/v1

# App Configuration
NODE_ENV=development
JWT_SECRET=change_this_to_a_random_secret
JWT_EXPIRES_IN=7d
DB_PATH=./yenyleths.db
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Mock payment mode (set to false for production Banco General integration)
MOCK_PAYMENT_MODE=true
