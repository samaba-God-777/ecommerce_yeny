# Valores por defecto del build. El hosting puede sobrescribirlos con sus
# propias variables; estos son los que se usan si no se definen alli.
# El API va por el mismo dominio: Hosting redirige /api a Cloud Run.
VITE_API_URL=/api

# El socket NO puede pasar por Hosting (no soporta WebSockets): necesita la
# direccion directa del servicio de Cloud Run. Se rellena tras el primer
# despliegue con la URL que imprime `npm run deploy:api`.
VITE_SOCKET_URL=
VITE_STORE_URL=https://ecommerce-yenny.web.app

# Firebase (proyecto ecommerce-yenny). No son secretos: viajan en el bundle y
# estan pensados para eso. Lo que protege los datos son las reglas de Firestore
# y la verificacion del token en el backend.
VITE_FIREBASE_API_KEY=AIzaSyB6xT6MJaNh6M-QXsCxa-s0VlhDhmznNQA
VITE_FIREBASE_AUTH_DOMAIN=ecommerce-yenny.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ecommerce-yenny
VITE_FIREBASE_STORAGE_BUCKET=ecommerce-yenny.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=56675185245
VITE_FIREBASE_APP_ID=1:56675185245:web:b1a07efd4a68590e3ad3b4
