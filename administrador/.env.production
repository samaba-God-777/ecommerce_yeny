# Valores de PRODUCCION. Vite da a .env.production mas prioridad que a
# .env.local, asi que un archivo de pruebas local ya no puede colarse en el
# build publicado: paso una vez y dejo el emulador dentro del bundle.

VITE_API_URL=https://ecommerce-yeny.onrender.com/api
VITE_SOCKET_URL=https://ecommerce-yeny.onrender.com
VITE_STORE_URL=https://ecommerce-yenny.web.app

VITE_FIREBASE_API_KEY=AIzaSyB6xT6MJaNh6M-QXsCxa-s0VlhDhmznNQA
VITE_FIREBASE_AUTH_DOMAIN=ecommerce-yenny.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ecommerce-yenny
VITE_FIREBASE_STORAGE_BUCKET=ecommerce-yenny.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=56675185245
VITE_FIREBASE_APP_ID=1:56675185245:web:b1a07efd4a68590e3ad3b4

# Sin emulador en produccion: si esta variable tiene valor, el SDK intenta
# hablar con 127.0.0.1 y no autentica nadie.
VITE_FIREBASE_AUTH_EMULATOR=
